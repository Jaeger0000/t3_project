# Üretim benzeri yığın için: `.env.prod` olarak kopyalayıp doldurun.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# .env.prod git'e ASLA girmez (bkz. .gitignore).

POSTGRES_DB="t3ekosistem"
POSTGRES_USER="t3"
POSTGRES_PASSWORD="uretim-icin-uzun-rastgele-bir-sifre"

# En az 32 karakter: openssl rand -base64 48
T3_JWT_SECRET="uretim-icin-uretilen-rastgele-anahtar"

# Kullanıcının tarayıcısına yazdığı adres. Şifre sıfırlama bağlantısı ve CORS
# listesi buradan kurulur; istekteki Host başlığına güvenilmiyor.
PUBLIC_BASE_URL="https://ekosistem.example.test"

# TLS sonlandıran vekilin (host'taki nginx'in) konteyner ağındaki adresi.
# X-Forwarded-* başlıklarına yalnızca bu adres adına güvenilir — liste
# yanlışsa denetim izindeki IP de yanlış olur ve hız sınırı herkesi tek
# kovaya koyar. Bu değer host loopback'i (127.0.0.1) DEĞİL, docker köprü ağ
# geçididir (tipik olarak 172.x.0.1). Bulmak için:
#   docker compose -f docker-compose.prod.yml up -d
#   docker network inspect t3_project_default | grep Gateway
TRUSTED_PROXY_IP="172.18.0.1"

# TLS'i bu uygulama mı zorunlu kılsın? Host'ta nginx/başka bir vekil TLS
# sonlandırıyorsa "true" bırakın (varsayılan) — HSTS ve çerezin Secure
# bayrağı buna bağlı. Yalnızca vekilsiz, düz HTTP ile test ederken "false"
# yapın; üretimde bilinçli bir karar olmadan asla.
REQUIRE_HTTPS="true"

# API yalnızca loopback'te dinler; dışarıya açan vekildir.
API_PORT="8080"

# Gönderen adresi: SMTP sağlayıcısında doğrulanmış olmalı, yoksa sağlayıcı
# mesajı reddeder. MAIL_REPLY_TO okunan gerçek kutudur — "no-reply" kutusu
# Zoho tarafında açılmıyor, cevaplar oraya düşerse kaybolur.
MAIL_FROM="no-reply@t3girisimportali.com"
MAIL_REPLY_TO="info@t3girisimportali.com"

# SMTP relay (Brevo). Dördü birden dolu değilse uygulama üretimde
# ThrowingEmailSender ile kalır: şifre sıfırlama açıkça hata verir, sessizce
# kaybolmaz. SMTP_PASSWORD panelde üretilen **SMTP key**'tir, hesap şifresi
# değil. Alan adı doğrulaması (SPF/DKIM/DMARC) yapılmadan gönderilen mail
# Gmail/Outlook tarafında spam'e düşer — bkz. docs/Mail_Servisi_Kurulumu.md.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="brevo-hesabinin-giris-adresi"
SMTP_PASSWORD="brevo-smtp-key"

# Panel içi AI yanıtları için opsiyonel. Boş bırakılırsa sistem MCP sunucusu
# olarak çalışmaya devam eder (harici ajan POST /mcp'ye kendi jetonuyla bağlanır).
T3_AI_API_KEY=
