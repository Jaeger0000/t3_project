{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "storage/logs/t3-.jsonl",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "t3-ekosistem",
    "Audience": "t3-ekosistem-api",
    "AccessTokenMinutes": 60
  },
  "DocumentStorage": {
    "RootPath": "storage/documents"
  },
  "Email": {
    "From": "no-reply@t3ekosistem.test",
    "FromName": "T3 Girişim Ekosistemi",
    "ReplyTo": "",
    "AppBaseUrl": "http://localhost:5173",
    "OutboxPath": "storage/outbox",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "UseStartTls": true,
      "TimeoutSeconds": 20
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Hosting": {
    "RequireHttps": false,
    "TrustedProxies": []
  }
}
