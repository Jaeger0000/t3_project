# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# .env dosyası git'e ASLA girmez (bkz. .gitignore).

# --- PostgreSQL (docker-compose) -----------------------------------------
POSTGRES_DB="t3ekosistem"
POSTGRES_USER="t3"
POSTGRES_PASSWORD="degistir-bu-sifreyi"
POSTGRES_PORT="5433"

# --- pgAdmin (opsiyonel: docker compose --profile tools up) --------------
PGADMIN_EMAIL="admin@t3.local"
PGADMIN_PASSWORD="admin"
PGADMIN_PORT="5050"

# --- Backend (T3_ önekli değişkenler ASP.NET Core yapılandırmasına geçer)
# Çift alt çizgi (__) iç içe bölümleri ifade eder: T3_Jwt__Secret -> Jwt:Secret
T3_ConnectionStrings__Default="Host=localhost;Port=5433;Database=t3ekosistem;Username=t3;Password=degistir-bu-sifreyi"

# En az 32 karakter olmalı. Üretim için: openssl rand -base64 48
T3_Jwt__Secret="en-az-32-karakterlik-rastgele-bir-anahtar-uretin"

# --- Yapay zekâ (opsiyonel) ----------------------------------------------
# Creathon kapsamında sağlanan Claude API anahtarı. Boş bırakılabilir:
# anahtar yoksa uygulama çalışmaya devam eder, sorular yerel planlayıcıyla
# yanıtlanır ve arayüz hangi modun yanıtladığını rozetle söyler.
T3_Ai__ApiKey=
T3_Ai__Model="claude-sonnet-5"
