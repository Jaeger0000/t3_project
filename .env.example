# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# .env dosyası git'e ASLA girmez (bkz. .gitignore).

# --- PostgreSQL (docker-compose) -----------------------------------------
POSTGRES_DB="t3ekosistem"
POSTGRES_USER="t3"
POSTGRES_PASSWORD="degistir-bu-sifreyi"
POSTGRES_PORT="5433"

# --- pgAdmin (opsiyonel: docker compose --profile tools up) --------------
# Zayıf/varsayılan bir şifre bırakmayın: giriş ekranı artık açık
# (PGADMIN_CONFIG_SERVER_MODE=True) ama port yine de yalnızca bu makineden
# erişilebilir olduğu için ikinci bir savunma katmanı (bkz. G-17).
PGADMIN_EMAIL="admin@t3.local"
PGADMIN_PASSWORD="degistir-bu-sifreyi"
PGADMIN_PORT="5050"

# --- Log sorgulama: Loki + Grafana (opsiyonel: docker compose --profile
# observability up) — bkz. docs/Loglama_Plani.md. Uygulama bunlar kapalıyken
# de çalışır: Serilog konsol + dosya sink'ine yazmaya devam eder.
LOKI_PORT="3100"
GRAFANA_PORT="3300"
T3_GRAFANA_PASSWORD="degistir-bu-sifreyi"

# --- Backend (T3_ önekli değişkenler ASP.NET Core yapılandırmasına geçer)
# Çift alt çizgi (__) iç içe bölümleri ifade eder: T3_Jwt__Secret -> Jwt:Secret
T3_ConnectionStrings__Default="Host=localhost;Port=5433;Database=t3ekosistem;Username=t3;Password=degistir-bu-sifreyi"

# En az 32 karakter olmalı. Üretim için: openssl rand -base64 48
T3_Jwt__Secret="en-az-32-karakterlik-rastgele-bir-anahtar-uretin"

# --- E-posta (opsiyonel) -------------------------------------------------
# Gerçek SMTP yok: şifre sıfırlama e-postaları sunucunun diskindeki geliştirme
# kutusuna yazılır (varsayılan: backend/src/T3.Api/storage/outbox). Sıfırlama
# bağlantısı istekteki Host başlığından değil bu adresten kurulur — aksi hâlde
# saldırgan kendi alan adına giden bir bağlantı ürettirebilirdi.
T3_Email__AppBaseUrl="http://localhost:5173"
T3_Email__From="no-reply@t3ekosistem.test"

# Aşağıdaki dört değer **birlikte** doluysa uygulama gerçek SMTP'ye bağlanır ve
# kutuya yazmayı bırakır — geliştirme makinesinde de. Yarım doldurulmuş
# yapılandırma yok sayılır (bkz. SmtpOptions.IsConfigured). Üretim değerleri
# .env.prod.example içinde; kurulum: docs/Mail_Servisi_Kurulumu.md.
# T3_Email__Smtp__Host="smtp-relay.brevo.com"
# T3_Email__Smtp__Port="587"
# T3_Email__Smtp__User="brevo-hesabinizin-giris-adresi"
# T3_Email__Smtp__Password="brevo-panelinden-uretilen-smtp-key"

# --- Barındırma (opsiyonel; üretim için .env.prod.example'a bakın) -------
# TLS'i uygulama sonlandırıyorsa true: HSTS + HTTP→HTTPS yönlendirmesi açılır.
# Ters vekil kurulumunda false kalır, iş vekile aittir (üretimde uyarı log'u
# düşer, sessiz bir "TLS yok" durumu yoktur).
# T3_Hosting__RequireHttps="false"
#
# X-Forwarded-* başlıklarına yalnızca bu adresler adına güvenilir. Boşsa
# yalnızca loopback. Denetim izindeki IP buradan geliyor: liste yanlışsa iz de
# yanlış olur.
# T3_Hosting__TrustedProxies__0="127.0.0.1"
#
# Şemayı API açılışta kursun mu? Geliştirmede `dotnet ef database update`
# kullanılıyor, konteynerde bu bayrak açık.
# T3_Database__MigrateOnStartup="false"

# --- Yapay zekâ (opsiyonel) ----------------------------------------------
# Bu kurulumda AI, uygulamanın içine gömülü bir model anahtarıyla değil **MCP
# sunucusu** olarak sunuluyor: harici ajan (Claude Desktop/Code) POST /mcp
# ucuna kendi jetonuyla bağlanır ve kendi yetkisi kadar görür. Aşağıdaki
# anahtar bu yüzden boş kalabilir; boşsa panel içi sorular yerel planlayıcıyla
# yanıtlanır ve arayüz hangi modun yanıtladığını açıkça söyler.
T3_Ai__ApiKey=
T3_Ai__Model="claude-sonnet-5"

# --- Tohum verisi (yalnızca geliştirme) -----------------------------------
# Seed:Enabled varsayılanı artık kapalı (bkz. appsettings.Development.json);
# şifrenin de kod içinde sabit bir varsayılanı yok. Bu tanımlanmazsa ve
# geliştirmede tohumlama açıksa uygulama açılışta hata verir. README'deki
# demo hesaplarıyla aynı değeri kullanın.
T3_Seed__Password="T3.Creathon!2026"
